<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="550"
        Width="400" Height="550"
        x:Class="minutnik.Views.MainWindow"
        Title="Minutnik Pomodoro">

    <StackPanel Margin="20" Spacing="15">
        <!-- Wyświetlacze czasu i cykli -->
        <TextBlock Name="TimeText" Text="25:00" FontSize="48" HorizontalAlignment="Center" FontWeight="Bold"/>
        <TextBlock Name="StatusText" Text="Praca" FontSize="20" HorizontalAlignment="Center" Foreground="Gray"/>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
            <TextBlock Text="Ukończone cykle:" FontSize="16" VerticalAlignment="Center"/>
            <TextBlock Name="CyclesText" Text="0" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Pola konfiguracyjne czasu -->
        <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" Margin="0,10,0,0">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Praca (min):" HorizontalAlignment="Center"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Przerwa (min):" HorizontalAlignment="Center"/>
            
            <TextBox Grid.Row="1" Grid.Column="0" Name="WorkInput" Text="25" Margin="5" HorizontalContentAlignment="Center"/>
            <TextBox Grid.Row="1" Grid.Column="1" Name="BreakInput" Text="5" Margin="5" HorizontalContentAlignment="Center"/>
        </Grid>

        <!-- Przyciski sterujące -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
            <Button Name="StartPauseButton" Content="Start" Width="100" HorizontalContentAlignment="Center" Click="OnStartPauseClick"/>
            <Button Name="ResetButton" Content="Reset" Width="100" HorizontalContentAlignment="Center" Click="OnResetClick"/>
        </StackPanel>

        <!-- Historia cykli (Własna ręka) -->
        <TextBlock Text="Historia cykli:" FontWeight="Bold" Margin="0,10,0,0"/>
        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Height="120">
            <ListBox Name="HistoryList"/>
        </Border>
    </StackPanel>
</Window>